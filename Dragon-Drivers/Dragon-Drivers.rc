/* =============================================================================
   Dragon-Drivers.rc

   版本资源。

   注意：现代 WDK 的 ntverp.h 会无条件定义 VER_PRODUCTVERSION /
   VER_PRODUCTVERSION_STR / VER_PRODUCTNAME_STR / VER_COMPANYNAME_STR
   （它们是 NT 产品版本的默认值）。为了让本驱动自己的版本与厂商信息生效、
   同时不产生 RC4005 重定义告警，这里在赋值前统一 #undef。
   ========================================================================== */

#include <windows.h>
#include <ntverp.h>

#undef  VER_FILETYPE
#undef  VER_FILESUBTYPE
#undef  VER_FILEDESCRIPTION_STR
#undef  VER_INTERNALNAME_STR
#undef  VER_LEGALCOPYRIGHT_STR
#undef  VER_ORIGINALFILENAME_STR
#undef  VER_PRODUCTNAME_STR
#undef  VER_FILEVERSION
#undef  VER_FILEVERSION_STR
#undef  VER_PRODUCTVERSION
#undef  VER_PRODUCTVERSION_STR
#undef  VER_COMPANYNAME_STR

#define VER_FILETYPE                VFT_DRV
#define VER_FILESUBTYPE             VFT2_DRV_SYSTEM
#define VER_FILEDESCRIPTION_STR     "Dragon Security Kernel Guard Driver"
#define VER_INTERNALNAME_STR        "Dragon-Drivers"
#define VER_LEGALCOPYRIGHT_STR      "Dragon Security"
#define VER_ORIGINALFILENAME_STR    "Dragon-Drivers.sys"
#define VER_PRODUCTNAME_STR         "Dragon Shield"

#define VER_FILEVERSION             1,0,0,0
#define VER_FILEVERSION_STR         "1.0.0.0"

#define VER_PRODUCTVERSION          1,0,0,0
#define VER_PRODUCTVERSION_STR      "1.0.0.0"

#define VER_COMPANYNAME_STR         "Dragon Security"

#include "common.ver"
