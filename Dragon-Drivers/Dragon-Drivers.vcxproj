  <!-- =======================================================================
       覆盖 WDK 自带的 InfVerif 目标。

       原因：该 WDK 安装中，InfVerif 的 MSBuild 任务固定去加载
             build\<version>\bin\x86\InfVerif.dll，
       但本机 WDK 只随附了 x64 / arm64 两个版本（x86 目录缺失），
       任务必然抛出「无法加载 DLL x86\InfVerif.dll」并使整个生成失败。
       这不是工程配置问题，而是 WDK 打包缺口。

       处理：改用 WDK 随附的命令行工具 infverif.exe 完成同样的 INF 静态校验，
             保留校验动作、绕开损坏的任务封装。
       如需彻底关闭该校验，删除本 Target 即可（不影响 .sys 产物）。
       ======================================================================= -->
  <Target Name="InfVerif"
          Condition="'@(Inf)' != ''"
          AfterTargets="StampInf"
          BeforeTargets="PreBuildEvent">
    <PropertyGroup>
      <_DragonInfVerifExe>$(WDKContentRoot)Tools\$(TargetPlatformVersion)\x64\infverif.exe</_DragonInfVerifExe>
    </PropertyGroup>
    <Message Importance="high" Text="Dragon-Drivers: 使用 $(_DragonInfVerifExe) 校验 INF" Condition="Exists('$(_DragonInfVerifExe)')" />
    <Message Importance="high" Text="Dragon-Drivers: 未找到 infverif.exe，跳过 INF 静态校验" Condition="!Exists('$(_DragonInfVerifExe)')" />
    <Exec Condition="Exists('$(_DragonInfVerifExe)')"
          Command="&quot;$(_DragonInfVerifExe)&quot; /Info &quot;%(Inf.FullPath)&quot;"
          IgnoreExitCode="true"
          ContinueOnError="true" />
  </Target>
</Project>
